{
  "name": "photobook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "PATH=\"$HOME/.cargo/bin:$PATH\" pnpm --filter editor tauri dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "pnpm -r build",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^5.9.3"
  }
}
