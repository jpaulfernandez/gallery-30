# Public base URL of your R2 bucket (custom domain or r2.dev URL), no trailing slash.
# The viewer fetches `<base>/site.json` and `<base>/books/<slug>/manifest.json` from it.
# Copy this file to `.env.production.local` (git-ignored) before `pnpm --filter viewer run deploy`.
VITE_R2_PUBLIC_URL=https://photos.example.com
