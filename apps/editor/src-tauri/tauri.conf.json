{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photobook",
  "version": "0.1.0",
  "identifier": "com.photobook.editor",
  "build": {
    "beforeDevCommand": "pnpm --filter editor dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter editor build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Photobook",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; script-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
