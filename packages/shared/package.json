{
  "name": "@photobook/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "source": "./src/fixtures/fixturePage.ts",
      "types": "./dist/fixtures/fixturePage.d.ts",
      "default": "./dist/fixtures/fixturePage.js"
    },
    "./fonts.css": "./fonts/fonts.css",
    "./renderer.css": "./src/renderer/renderer.css",
    "./social": {
      "source": "./src/publish/social.ts",
      "types": "./dist/publish/social.d.ts",
      "default": "./dist/publish/social.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "src/renderer/renderer.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "fonts:sync": "node scripts/sync-fonts.mjs"
  },
  "dependencies": {
    "ulidx": "^2.4.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
