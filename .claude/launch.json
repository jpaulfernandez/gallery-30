{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "viewer",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "viewer", "dev"],
      "port": 5173
    },
    {
      "name": "viewer-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "viewer", "preview", "--", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "editor-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "editor", "dev"],
      "port": 1420
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4323", "--directory", "apps/site/public"],
      "port": 4323
    }
  ]
}
